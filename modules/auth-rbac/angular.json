{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false
  },
  "newProjectRoot": "demo",
  "projects": {
    "demo-angular": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "demo/angular/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/demo-angular",
            "index": "demo/angular/src/index.html",
            "browser": "demo/angular/src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "demo/angular/tsconfig.app.json",
            "styles": ["demo/shared/demo.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1mb",
                  "maximumError": "2mb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "port": 4200,
            "host": "127.0.0.1"
          },
          "configurations": {
            "development": {
              "buildTarget": "demo-angular:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
