{
  "name": "@krishnadas/auth-rbac",
  "version": "0.1.0",
  "private": true,
  "description": "OIDC and JWT authentication with role-based access for NestJS, React and Angular",
  "author": "Krishna Das <7599778+kr1shnadas@users.noreply.github.com>",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react/require-role.tsx",
    "./angular": "./src/angular/role.guard.ts"
  },
  "scripts": {
    "dev": "concurrently -n idp,api,react,angular -c blue,green,magenta,yellow \"pnpm dev:idp\" \"pnpm dev:api\" \"pnpm dev:react\" \"pnpm dev:angular\"",
    "dev:idp": "tsx src/demo-idp/main.ts",
    "dev:api": "tsx demo/api/main.ts",
    "dev:react": "vite --config demo/react/vite.config.ts",
    "dev:angular": "NG_CLI_ANALYTICS=false ng serve demo-angular --port 4200 --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@angular/common": "^19.2.14",
    "@angular/compiler": "^19.2.14",
    "@angular/core": "^19.2.14",
    "@angular/platform-browser": "^19.2.14",
    "@angular/router": "^19.2.14",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "jose": "^5.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.15",
    "@angular/cli": "^19.2.15",
    "@angular/compiler-cli": "^19.2.14",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.1.2",
    "supertest": "^7.1.1",
    "tsx": "^4.20.3",
    "typescript": "5.8.3",
    "vite": "^6.3.5",
    "vitest": "^2.1.9"
  }
}
