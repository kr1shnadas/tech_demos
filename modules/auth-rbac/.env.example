AUTH_PROVIDER=local
AUTH_ISSUER=http://localhost:4100
AUTH_AUDIENCE=auth-rbac-demo
AUTH_CLIENT_ID=auth-rbac-demo
AUTH_JWKS_URI=http://localhost:4100/jwks
AUTH_ROLES_CLAIM=roles
AUTH_CLOCK_TOLERANCE=60

# Rename identity-provider groups into application roles. JSON object.
# AUTH_ROLE_MAP={"Study-Clinicians":"clinician","Study-Auditors":"auditor"}

# Okta
# AUTH_PROVIDER=okta
# OKTA_DOMAIN=dev-example.okta.com
# OKTA_AUTH_SERVER_ID=default
# AUTH_CLIENT_ID=
# AUTH_AUDIENCE=api://study
# AUTH_ROLES_CLAIM=groups

# Azure AD
# AUTH_PROVIDER=azure-ad
# AZURE_TENANT_ID=
# AUTH_CLIENT_ID=
# AUTH_AUDIENCE=api://your-api-client-id
# AUTH_ROLES_CLAIM=roles

# Keycloak (see docker-compose.yml)
# AUTH_PROVIDER=keycloak
# KEYCLOAK_BASE_URL=http://localhost:8080
# KEYCLOAK_REALM=study
# AUTH_CLIENT_ID=auth-rbac-demo
# AUTH_AUDIENCE=auth-rbac-demo
# AUTH_JWKS_URI=http://localhost:8080/realms/study/protocol/openid-connect/certs
# AUTH_ROLES_CLAIM=realm_access.roles
