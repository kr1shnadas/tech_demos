# Defaults match defineDeployConfig. Set a variable only when you want to override it.
DEPLOY_REGION=us-east-1
DEPLOY_SERVICE_NAME=deploy-demo
DEPLOY_CONTAINER_PORT=3000
DEPLOY_CPU=256
DEPLOY_MEMORY=512
DEPLOY_DESIRED_COUNT=1
DEPLOY_ENVIRONMENT=dev
DEPLOY_IMAGE_TAG_STRATEGY=git-sha
DEPLOY_IMAGE_TAG=local
DEPLOY_ENABLE_LAMBDA=false
DEPLOY_LAMBDA_MEMORY=512
DEPLOY_LAMBDA_TIMEOUT=15
DEPLOY_VPC_CIDR=10.40.0.0/16
DEPLOY_AVAILABILITY_ZONES=us-east-1a,us-east-1b
DEPLOY_ENABLE_NAT_GATEWAY=false
DEPLOY_DELETION_PROTECTION=false
DEPLOY_ENABLE_GITHUB_OIDC=false
DEPLOY_GITHUB_ORG=
DEPLOY_GITHUB_REPO=
DEPLOY_GITHUB_BRANCH=main

# semver tagging reads this when DEPLOY_IMAGE_TAG is unset
# DEPLOY_VERSION=0.1.0

# Listen port for the demo process. Defaults to DEPLOY_CONTAINER_PORT.
PORT=3000
