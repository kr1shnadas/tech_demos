# Copy to .env to override the defaults. Values already in the environment win.
O11Y_SERVICE_NAME=observability
O11Y_SERVICE_VERSION=0.1.0
O11Y_TRACING_ENABLED=true
O11Y_EXPORTER_ENDPOINT=http://localhost:4318/v1/traces
O11Y_SAMPLING_RATIO=1
O11Y_LOGGING_ENABLED=true
O11Y_LOG_LEVEL=info
O11Y_REDACT_FIELDS=password,authorization,token,secret,apiKey,api_key,cookie,set-cookie
O11Y_METRICS_ENABLED=true
O11Y_METRICS_PATH=/metrics
O11Y_LIVENESS_PATH=/health/live
O11Y_READINESS_PATH=/health/ready
PORT=3000
CATALOG_BASE_URL=http://127.0.0.1:3001
SLOW_MS=800
