# Copy to .env to override the defaults. Values already in the environment win.
JOBS_REDIS_HOST=127.0.0.1
JOBS_REDIS_PORT=6379
JOBS_REDIS_PASSWORD=
JOBS_REDIS_DB=0
JOBS_REDIS_TLS=false
JOBS_PREFIX=bg
JOBS_ATTEMPTS=5
JOBS_BACKOFF_TYPE=exponential
JOBS_BACKOFF_DELAY_MS=2000
JOBS_REMOVE_ON_COMPLETE=1000
JOBS_REMOVE_ON_FAIL=5000
JOBS_CONCURRENCY=5
JOBS_RATE_LIMIT_MAX=50
JOBS_RATE_LIMIT_DURATION_MS=1000
JOBS_DEAD_LETTER_QUEUE=dead-letter
JOBS_LIVENESS_PATH=/health/live
JOBS_READINESS_PATH=/health/ready
PORT=3000
