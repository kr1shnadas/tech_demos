# Copy to .env to override the defaults. Values already in the environment win.
TENANT_SOURCE=jwt
TENANT_JWT_CLAIM=tenant_id
TENANT_HEADER=x-tenant-id
TENANT_BASE_DOMAIN=localhost
TENANT_ISOLATION=rls
AUDIT_SINK=postgres
AUDIT_TABLE=audit_events
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=iam
POSTGRES_PASSWORD=iam
POSTGRES_DATABASE=iam
POSTGRES_APP_USER=iam_app
POSTGRES_APP_PASSWORD=iam_app
PORT=3000
