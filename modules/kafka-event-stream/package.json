{
  "name": "@krishnadas/kafka-event-stream",
  "version": "0.1.0",
  "private": true,
  "description": "Transactional outbox, idempotent consumers and retry topics on Kafka",
  "author": "Krishna Das <7599778+kr1shnadas@users.noreply.github.com>",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "concurrently -n api,react -c green,magenta \"pnpm dev:api\" \"pnpm dev:react\"",
    "dev:api": "tsx demo/api/main.ts",
    "dev:react": "vite --config demo/react/vite.config.ts",
    "build": "tsc -p tsconfig.build.json && vite build --config demo/react/vite.config.ts",
    "start": "node dist/demo/api/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "express": "^4.21.2",
    "kafkajs": "^2.2.4",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@testcontainers/kafka": "^12.2.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "^7.1.1",
    "testcontainers": "^12.2.1",
    "tsx": "^4.20.3",
    "typescript": "5.8.3",
    "vite": "^6.3.5",
    "vitest": "^2.1.9"
  }
}
