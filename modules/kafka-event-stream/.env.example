# Copy to .env to override the defaults. Values already in the environment win.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=kafka-event-stream
KAFKA_CONSUMER_GROUP=study-ingestion
KAFKA_TOPIC_EVENTS=study.ingestion
KAFKA_TOPIC_RETRY_PREFIX=study.ingestion.retry
KAFKA_TOPIC_DEAD_LETTER=study.ingestion.dlt
KAFKA_PARTITIONS=3
KAFKA_RETRY_MAX_ATTEMPTS=3
KAFKA_RETRY_BACKOFF_MS=1000
KAFKA_RETRY_MULTIPLIER=2
KAFKA_IDEMPOTENCY_TABLE=processed_events
KAFKA_IDEMPOTENCY_TTL_SECONDS=86400
KAFKA_OUTBOX_TABLE=outbox
KAFKA_OUTBOX_POLL_MS=500
KAFKA_OUTBOX_BATCH_SIZE=50
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=events
POSTGRES_PASSWORD=events
POSTGRES_DATABASE=events
PORT=3000
