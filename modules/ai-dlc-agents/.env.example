# Copy to .env to override the defaults. Values already in the environment win.
DLC_PROFILE=startup
DLC_PROVIDER=mock
DLC_PROVIDER_BASE_URL=http://127.0.0.1:8080/v1
DLC_MODEL=mock-deterministic
DLC_PROVIDER_API_KEY_ENV=DLC_PROVIDER_API_KEY
DLC_PROVIDER_API_KEY=
DLC_PROVIDER_TIMEOUT_MS=30000
DLC_OUTPUT_ROOT=output
DLC_CONFIG=examples/nestjs-crud.yaml
PORT=3000
